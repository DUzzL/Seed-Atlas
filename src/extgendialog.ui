<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ExtGenDialog</class>
 <widget class="QDialog" name="ExtGenDialog">
  <property name="windowTitle">
   <string>Advanced world settings</string>
  </property>
  <property name="windowIcon">
   <iconset resource="../rc/icons.qrc">
    <normaloff>:/icons/logo.png</normaloff>:/icons/logo.png</iconset>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="3" column="0" colspan="2">
    <widget class="QGroupBox" name="groupSalts">
     <property name="toolTip">
      <string>A salt is a fixed number that each structure type adds to the seed to pick its positions. Change it to match servers or data packs that use different salts.</string>
     </property>
     <property name="title">
      <string>Override structure salts</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok|QDialogButtonBox::RestoreDefaults</set>
     </property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QCheckBox" name="checkEstimate">
     <property name="toolTip">
      <string>Leave out structures that cannot generate because of the terrain, using an estimate of the surface height. Applies to the map and the Seed Finder in 1.18 and newer.</string>
     </property>
     <property name="text">
      <string>Check the terrain at structures (1.18+)</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QCheckBox" name="checkExperimental">
     <property name="toolTip">
      <string>Also list Minecraft versions whose world generation is only partly supported</string>
     </property>
     <property name="text">
      <string>Show versions with experimental support</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources>
  <include location="../rc/icons.qrc"/>
 </resources>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>ExtGenDialog</receiver>
   <slot>accept()</slot>
   <hints>
