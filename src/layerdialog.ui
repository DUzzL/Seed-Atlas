     </property>
     <property name="text">
      <string>Beta 1.7 biomes without oceans</string>
     </property>
    </widget>
   </item>
   <item row="5" column="0">
    <widget class="QRadioButton" name="radioNoiseC">
     <property name="toolTip">
      <string>Continentalness climate value: low is ocean, high is far inland. Each climate value is built from several noise layers (octaves), from broad to fine. The list can show only the broadest ones, to see the large-scale pattern.</string>
     </property>
     <property name="text">
      <string>Continentalness (1.18+):</string>
     </property>
    </widget>
   </item>
   <item row="15" column="0">
    <widget class="QRadioButton" name="radioTerrain">
     <property name="text">
      <string>Terrain map</string>
     </property>
    </widget>
   </item>
   <item row="16" column="0">
    <widget class="QRadioButton" name="radioStruct">
     <property name="toolTip">
      <string>Hide the Overworld biomes and show every position where a structure is attempted, before the biome check. These positions depend only on the structure seed (the lower 48 bits of the seed).</string>
     </property>
     <property name="text">
      <string>Possible structure positions</string>
     </property>
    </widget>
   </item>
   <item row="6" column="0">
    <widget class="QRadioButton" name="radioNoiseE">
     <property name="toolTip">
      <string>Erosion climate value: low gives mountainous, high flat terrain. Each climate value is built from several noise layers (octaves), from broad to fine. The list can show only the broadest ones, to see the large-scale pattern.</string>
     </property>
     <property name="text">
      <string>Erosion (1.18+):</string>
     </property>
    </widget>
   </item>
   <item row="9" column="0">
    <widget class="QRadioButton" name="radioRiver">
     <property name="toolTip">
      <string>The 1.13 to 1.17 biome layer right after rivers are added, before oceans get their temperature variants, at 1:4</string>
     </property>
     <property name="text">
      <string>Biomes before ocean temperatures (1.13 - 1.17)</string>
     </property>
