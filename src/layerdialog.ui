   <item row="7" column="0">
    <widget class="QRadioButton" name="radioNoiseD">
     <property name="toolTip">
      <string>The depth value at the selected Y level, which the 1.18+ generator uses for cave biomes</string>
     </property>
     <property name="text">
      <string>Depth (1.18+)</string>
     </property>
    </widget>
   </item>
   <item row="8" column="0">
    <widget class="QRadioButton" name="radioNoiseW">
     <property name="toolTip">
      <string>Weirdness climate value, which selects biome variants and where peaks and valleys form. Each climate value is built from several noise layers (octaves), from broad to fine. The list can show only the broadest ones, to see the large-scale pattern.</string>
     </property>
     <property name="text">
      <string>Weirdness (1.18+):</string>
     </property>
    </widget>
   </item>
   <item row="0" column="0">
    <widget class="QRadioButton" name="radioBiomes">
     <property name="toolTip">
      <string>The normal biome map. At 1:4, one sample covers 4 by 4 blocks.</string>
     </property>
     <property name="text">
      <string>Biomes at scale:</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="StyledComboBox" name="comboNoiseT">
     <property name="iconSize">
      <size>
       <width>0</width>
       <height>16</height>
      </size>
     </property>
    </widget>
   </item>
   <item row="17" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Apply|QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QRadioButton" name="radioNoiseT">
     <property name="toolTip">
      <string>Temperature climate value. Each climate value is built from several noise layers (octaves), from broad to fine. The list can show only the broadest ones, to see the large-scale pattern.</string>
     </property>
     <property name="text">
      <string>Temperature (1.18+):</string>
     </property>
    </widget>
   </item>
   <item row="10" column="0">
    <widget class="QRadioButton" name="radioOcean">
     <property name="toolTip">
      <string>The ocean temperature layer of 1.13 to 1.17 (warm, lukewarm, cold, frozen), at 1:256</string>
     </property>
     <property name="text">
      <string>Ocean temperature (1.13 - 1.17)</string>
     </property>
    </widget>
   </item>
   <item row="14" column="1">
    <widget class="StyledComboBox" name="comboHeight">
     <property name="iconSize">
      <size>
       <width>0</width>
       <height>16</height>
      </size>
     </property>
    </widget>
   </item>
   <item row="14" column="0">
    <widget class="QRadioButton" name="radioHeight">
     <property name="toolTip">
      <string>An estimate of the terrain height, computed without generating the full terrain</string>
     </property>
     <property name="text">
      <string>Approximate surface height:</string>
     </property>
    </widget>
