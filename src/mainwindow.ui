  <action name="actionAbout">
   <property name="text">
    <string>About</string>
   </property>
  </action>
  <action name="actionOpenShadow">
   <property name="text">
    <string>Open shadow seed</string>
   </property>
   <property name="toolTip">
    <string>Open the shadow seed of the current seed. Up to 1.17, a seed and its shadow seed have the same biome layout but different terrain and structures.</string>
   </property>
  </action>
  <action name="actionSave">
   <property name="text">
    <string>Save session...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+S</string>
   </property>
  </action>
  <action name="actionLoad">
   <property name="text">
    <string>Load session...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+O</string>
   </property>
  </action>
  <action name="actionSearch_seed_list">
   <property name="text">
    <string>Search seed list...</string>
   </property>
   <property name="toolTip">
    <string>Search only the seeds listed in a text file</string>
   </property>
  </action>
  <action name="actionSearch_full_seed_space">
   <property name="text">
    <string>Search all seeds, structure seeds first</string>
   </property>
   <property name="toolTip">
    <string>Search every possible seed instead of a seed list, grouped by structure seed (the lower 48 bits)</string>
   </property>
  </action>
  <action name="actionCopy">
   <property name="text">
    <string>Copy matching seeds</string>
   </property>
  </action>
  <action name="actionPaste">
   <property name="text">
    <string>Paste seeds into matching seeds</string>
   </property>
  </action>
  <action name="actionPreferences">
   <property name="text">
    <string>Settings...</string>
   </property>
  </action>
  <action name="actionQuit">
   <property name="text">
    <string>Quit</string>
   </property>
  </action>
  <action name="actionAddShadow">
   <property name="text">
    <string>Add shadow seeds of all matching seeds</string>
   </property>
   <property name="toolTip">
    <string>Add the shadow seed of every matching seed to the list. Up to 1.17, a shadow seed has the same biome layout but different terrain and structures.</string>
   </property>
  </action>
  <action name="actionExtGen">
   <property name="text">
    <string>Advanced world settings...</string>
   </property>
   <property name="toolTip">
    <string>Structure salt overrides, the terrain estimate and experimental versions</string>
   </property>
  </action>
  <action name="actionPresetLoad">
   <property name="text">
    <string>Saved filters...</string>
   </property>
  </action>
  <action name="actionBiomeColors">
   <property name="text">
    <string>Edit biome colors...</string>
   </property>
  </action>
  <action name="actionBiomes">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Biomes (default)</string>
   </property>
   <property name="toolTip">
    <string>The normal biome map. Alt+0 to Alt+4 switch between 1:1 and 1:256 (blocks per biome sample).</string>
   </property>
   <property name="shortcut">
    <string>Alt+B</string>
   </property>
  </action>
  <action name="actionGoto">
   <property name="text">
    <string>Go to...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+G</string>
   </property>
  </action>
  <action name="actionOceanTemp">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.13 - 1.17) Ocean temperature (1:256)</string>
   </property>
   <property name="toolTip">
    <string>The ocean temperature layer of 1.13 to 1.17 (warm, lukewarm, cold, frozen). At 1:256, one sample covers 256 by 256 blocks.</string>
   </property>
   <property name="shortcut">
    <string>Alt+O</string>
   </property>
  </action>
  <action name="actionRiver">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.13 - 1.17) Biomes before ocean temperatures (1:4)</string>
   </property>
   <property name="toolTip">
    <string>The 1.13 to 1.17 biome layer right after rivers are added, before oceans get their temperature variants. At 1:4, one sample covers 4 by 4 blocks.</string>
   </property>
   <property name="shortcut">
    <string>Alt+R</string>
   </property>
  </action>
  <action name="actionExportImg">
   <property name="text">
    <string>Export biomes as image...</string>
   </property>
  </action>
  <action name="actionToolbarConfig">
   <property name="text">
    <string>Map buttons...</string>
   </property>
   <property name="toolTip">
    <string>Choose which layers get a button in the layer sidebar, and up to which zoom level their icons are shown</string>
   </property>
  </action>
  <action name="actionParaTemperature">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Temperature</string>
   </property>
   <property name="toolTip">
    <string>Show the temperature climate value, one of the values the 1.18+ generator uses to pick biomes</string>
   </property>
   <property name="shortcut">
    <string>Alt+T</string>
   </property>
  </action>
  <action name="actionParaHumidity">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Humidity</string>
   </property>
   <property name="toolTip">
    <string>Show the humidity (vegetation) climate value, one of the values the 1.18+ generator uses to pick biomes</string>
   </property>
   <property name="shortcut">
    <string>Alt+H</string>
   </property>
  </action>
  <action name="actionParaContinentalness">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Continentalness</string>
   </property>
   <property name="toolTip">
    <string>Show the continentalness climate value: low values are ocean, high values are far inland</string>
   </property>
   <property name="shortcut">
    <string>Alt+C</string>
   </property>
  </action>
  <action name="actionParaErosion">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Erosion</string>
   </property>
   <property name="toolTip">
    <string>Show the erosion climate value: low values give mountainous terrain, high values flat terrain</string>
   </property>
   <property name="shortcut">
    <string>Alt+E</string>
   </property>
  </action>
  <action name="actionParaWeirdness">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Weirdness</string>
   </property>
   <property name="toolTip">
    <string>Show the weirdness climate value, which selects biome variants and where peaks and valleys form</string>
   </property>
   <property name="shortcut">
    <string>Alt+W</string>
   </property>
  </action>
  <action name="actionParaDepth">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>(1.18+) Depth</string>
   </property>
   <property name="toolTip">
    <string>Show the depth value at the selected Y level, which the 1.18+ generator uses for cave biomes</string>
   </property>
   <property name="shortcut">
    <string>Alt+D</string>
   </property>
  </action>
  <action name="actionStructures">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Possible structure positions</string>
   </property>
   <property name="toolTip">
    <string>Hide the Overworld biomes and show every position where a structure is attempted, before the biome check. These positions depend only on the structure seed (the lower 48 bits of the seed).</string>
   </property>
   <property name="shortcut">
    <string>Alt+S</string>
   </property>
  </action>
  <action name="actionScreenshot">
   <property name="text">
    <string>Take screenshot</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+S</string>
   </property>
  </action>
  <action name="actionDock">
   <property name="text">
    <string>Undock map</string>
   </property>
  </action>
  <action name="actionHeight">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Approximate surface height</string>
   </property>
   <property name="toolTip">
